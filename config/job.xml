<?xml version='1.1' encoding='UTF-8'?>
<!-- Template for the job jenkins-local creates per repo. At every run it fills in the repo
     path (description) and the repo's Jenkinsfile, XML-escaped (script). Keep the
     placeholders out of this comment: a Jenkinsfile can contain "-" "-", which XML forbids here. -->
<flow-definition plugin="workflow-job">
  <description>Local build of __REPO__ (working tree, managed by jenkins-local; edits here are overwritten).</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <!-- Keep the last 20 builds. A Jenkinsfile's own options { buildDiscarder(...) } wins. -->
    <jenkins.model.BuildDiscarderProperty>
      <strategy class="hudson.tasks.LogRotator">
        <daysToKeep>-1</daysToKeep>
        <numToKeep>20</numToKeep>
        <artifactDaysToKeep>-1</artifactDaysToKeep>
        <artifactNumToKeep>-1</artifactNumToKeep>
      </strategy>
    </jenkins.model.BuildDiscarderProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsFlowDefinition" plugin="workflow-cps">
    <script>__SCRIPT__</script>
    <sandbox>true</sandbox>
  </definition>
  <disabled>false</disabled>
</flow-definition>
