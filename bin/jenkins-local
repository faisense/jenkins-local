#!/usr/bin/env bash
# A local Jenkins for trying any project's Jenkinsfile. Not a CI server: it builds on demand.
#
#   jenkins-local            in a git repo with a Jenkinsfile: build the working tree as it is
#                            now, stream the log, exit with the build's result (starts Jenkins
#                            if needed). The repo's .env, if there is one, supplies its secrets:
#                            each KEY=value line, overriding a global secret of the same ID,
#                            for this repo only.
#   jenkins-local -e FILE    use another env file instead (--env-file)
#   jenkins-local --no-env   no repo secrets; only the global ones apply
#   jenkins-local --keep-workspace
#                            keep the build's workspace afterwards (deleted by default)
#   jenkins-local status     running or not, disk use, global secrets, jobs (and stale ones)
#   jenkins-local prune      delete leftover workspaces (refuses while a build runs)
#   jenkins-local selftest   build a small sample project and check each feature: docker
#                            agent, workspace, .env secret, artifacts, test report, cleanup
#   jenkins-local start      start Jenkins (http://127.0.0.1:8090)
#   jenkins-local restart    rebuild the image and recreate the container; needed after editing
#                            Dockerfile or plugins.txt
#   jenkins-local stop       stop it; jobs and build history are kept
#   jenkins-local logs       follow Jenkins' own log
#
#   jenkins-local secret set ID     store a "Secret text" credential; asks for the value (hidden),
#                                   or reads it from stdin: ... | jenkins-local secret set ID
#   jenkins-local secret list       list the IDs (never the values)
#   jenkins-local secret rm ID      delete one
# A Jenkinsfile uses them with withCredentials([string(credentialsId: 'ID', variable: ...)]).
# Changes apply to a running Jenkins at once; no restart.
#
# No commit needed: each build starts from a fresh copy of the files git would commit
# (tracked + untracked, minus .gitignore'd ones like .venv and .env), and the Jenkinsfile
# on disk.
#
# Files:
#   <this repo>/config/               Dockerfile, plugins.txt, job.xml (per-repo job template)
#   ~/.config/jenkins-local/secrets/  one file per secret (managed by `secret`), mode 600;
#                                     outside the repo, so never committed
#   ~/.local/share/jenkins-local/     JENKINS_HOME: jobs, builds, workspaces
#
# Settings (environment):
#   JENKINS_LOCAL_PORT    default 8090
#   JENKINS_LOCAL_WARN_GB every build warns when the data passes this size; default 5
#
# Disk use stays bounded: workspaces are deleted after each build, jobs keep their last 20
# builds (unless the Jenkinsfile sets its own buildDiscarder), the container log is capped
# at 30 MB, and anything over JENKINS_LOCAL_WARN_GB is reported on every build.
set -euo pipefail

# The image and job template live in the repo, next to bin/ (found through the
# ~/.local/bin symlink); per-machine state lives outside it.
conf=$(cd "$(dirname "$(realpath "$0")")/../config" && pwd)
home=${XDG_DATA_HOME:-$HOME/.local/share}/jenkins-local
port=${JENKINS_LOCAL_PORT:-8090}
warn_gb=${JENKINS_LOCAL_WARN_GB:-5}
secrets=${XDG_CONFIG_HOME:-$HOME/.config}/jenkins-local/secrets
name=jenkins-local
image=jenkins-local

die() { echo "jenkins-local: $*" >&2; exit 1; }

running() { [ "$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null)" = true ]; }

cli() {
  docker exec -i "$name" java -jar "$home/jenkins-cli.jar" -s http://localhost:8080/ -http "$@"
}

# casc.yaml lists the credential IDs only. JCasC resolves each ${ID} from the file of that
# name in /run/secrets (the secrets directory, mounted read-only), so values stay in one place.
write_casc() {
  {
    echo "# Generated by jenkins-local at every start; edit the script, not this file."
    echo "jenkins:"
    echo "  systemMessage: \"Local Jenkins for trying Jenkinsfiles (jenkins-local).\""
    echo "  numExecutors: 2"
    echo "  authorizationStrategy: unsecured   # bound to 127.0.0.1 only"
    echo "unclassified:"
    echo "  location:"
    echo "    url: \"http://127.0.0.1:$port/\"   # the CLI refuses to connect without one"
    echo "credentials:"
    echo "  system:"
    echo "    domainCredentials:"
    echo "      - credentials:"
    local f found=0
    for f in "$secrets"/*; do
      [ -f "$f" ] || continue
      found=1
      echo "          - string: {scope: GLOBAL, id: \"${f##*/}\", secret: \"\${${f##*/}}\"}"
    done
    [ "$found" = 1 ] || echo "          []"
  } > "$home/casc.yaml"
}

# Apply casc.yaml to a running Jenkins (credentials included) without restarting it.
apply_casc() {
  write_casc
  if running; then
    cli reload-jcasc-configuration && echo "applied to the running Jenkins" >&2
  fi
}

secret() {
  local id
  case "${1:-}" in
    set)
      id=${2:-}; valid_id "$id"
      local value
      if [ -t 0 ]; then
        read -rsp "Value for $id (hidden): " value; echo >&2
      else
        IFS= read -r value || [ -n "$value" ]
      fi
      [ -n "$value" ] || die "empty value; nothing stored"
      mkdir -p "$secrets" && chmod 700 "$secrets"
      # No trailing newline: the file's content is the secret, byte for byte.
      (umask 077 && printf '%s' "$value" > "$secrets/$id")
      echo "stored $id" >&2
      apply_casc
      ;;
    list)
      [ -d "$secrets" ] && ls -1 "$secrets"
      ;;
    rm)
      id=${2:-}; valid_id "$id"
      [ -f "$secrets/$id" ] || die "no secret '$id' (see: jenkins-local secret list)"
      rm -f "$secrets/$id"
      echo "removed $id" >&2
      apply_casc
      ;;
    *) die "usage: jenkins-local secret set|list|rm [ID]" ;;
  esac
}

# Letters, digits and _ only: the ID is also the ${...} name JCasC resolves.
valid_id() {
  [[ "${1:-}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "secret ID must match [A-Za-z_][A-Za-z0-9_]* (got '${1:-}')"
}

start() {
  running && return 0
  [ -f "$conf/Dockerfile" ] || die "missing $conf/Dockerfile"
  mkdir -p "$home" "$secrets" && chmod 700 "$secrets"
  write_casc

  echo "Building the image..." >&2
  docker build -q -t "$image" "$conf" >/dev/null
  docker rm -f "$name" >/dev/null 2>&1 || true

  # JENKINS_HOME at the same absolute path inside and out: a docker agent asks the host's
  # daemon to mount the workspace, and this script fills workspaces from the host.
  # Runs as you, so workspace files are yours and the docker socket's group applies.
  # The container log is capped (Docker keeps it forever otherwise).
  docker run -d --name "$name" --restart unless-stopped \
    --log-opt max-size=10m --log-opt max-file=3 \
    -u "$(id -u):$(id -g)" --group-add "$(stat -c %g /var/run/docker.sock)" \
    -p "127.0.0.1:$port:8080" \
    -e JENKINS_HOME="$home" -e HOME="$home" \
    -e COPY_REFERENCE_FILE_LOG="$home/copy_reference_file.log" \
    -v "$home:$home" \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -e CASC_JENKINS_CONFIG="$home/casc.yaml" \
    -v "$secrets:/run/secrets:ro" \
    "$image" >/dev/null

  echo "Waiting for Jenkins at http://127.0.0.1:$port ..." >&2
  local i
  for i in $(seq 120); do
    curl -sf -o /dev/null "http://127.0.0.1:$port/login" && break
    running || { docker logs --tail 20 "$name" >&2; die "Jenkins exited during startup"; }
    sleep 1
  done
  curl -sf -o /dev/null "http://127.0.0.1:$port/login" || die "Jenkins did not come up; see: jenkins-local logs"
  curl -sf -o "$home/jenkins-cli.jar" "http://127.0.0.1:$port/jnlpJars/jenkins-cli.jar"
  echo "Jenkins is up: http://127.0.0.1:$port" >&2
}

xml_escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

# KEY=value lines of an env file as "KEY<TAB>value": `export` prefix, quotes and inline
# " # comments" handled as docker compose does; blank values skipped.
read_env_file() {
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    [[ $line =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    key=${BASH_REMATCH[2]} val=${BASH_REMATCH[3]}
    if [[ $val =~ ^\"(.*)\"[[:space:]]*(#.*)?$ || $val =~ ^\'(.*)\'[[:space:]]*(#.*)?$ ]]; then
      val=${BASH_REMATCH[1]}
    else
      val=$(sed -e 's/[[:space:]]\{1,\}#.*$//' -e 's/[[:space:]]*$//' <<< "$val")
    fi
    if [ -n "$val" ]; then printf '%s\t%s\n' "$key" "$val"; fi
  done < "$1"
}

# Config of the repo's folder. Folder credentials override global ones with the same ID for
# the jobs inside, so each repo can have its own values. Without an env file the folder has
# none, and the global `secret` store applies. Secrets are in plain text here; Jenkins
# encrypts them on save. Printed to stdout only, for piping straight into the CLI.
folder_xml() {
  local env_file=${1:-} key val
  echo "<com.cloudbees.hudson.plugins.folder.Folder>"
  echo "  <description>$(xml_escape <<< "${2:-}")</description>"
  echo "  <properties>"
  if [ -n "$env_file" ]; then
    echo "    <com.cloudbees.hudson.plugins.folder.properties.FolderCredentialsProvider_-FolderCredentialsProperty>"
    echo "      <domainCredentialsMap class=\"hudson.util.CopyOnWriteMap\$Hash\"><entry>"
    echo "        <com.cloudbees.plugins.credentials.domains.Domain><specifications/></com.cloudbees.plugins.credentials.domains.Domain>"
    echo "        <java.util.concurrent.CopyOnWriteArrayList>"
    while IFS=$'\t' read -r key val; do
      echo "          <org.jenkinsci.plugins.plaincredentials.impl.StringCredentialsImpl>"
      echo "            <scope>GLOBAL</scope><id>$key</id>"
      echo "            <description>$(xml_escape <<< "from $env_file")</description>"
      echo "            <secret>$(xml_escape <<< "$val")</secret>"
      echo "          </org.jenkinsci.plugins.plaincredentials.impl.StringCredentialsImpl>"
    done < <(read_env_file "$env_file")
    echo "        </java.util.concurrent.CopyOnWriteArrayList>"
    echo "      </entry></domainCredentialsMap>"
    echo "    </com.cloudbees.hudson.plugins.folder.properties.FolderCredentialsProvider_-FolderCredentialsProperty>"
  fi
  echo "  </properties>"
  echo "</com.cloudbees.hudson.plugins.folder.Folder>"
}

kb_to_human() { awk -v k="$1" 'BEGIN { split("K M G T", u); i = 1; while (k >= 1024 && i < 4) { k /= 1024; i++ } printf "%.1f%s", k, u[i] }'; }

# The biggest things in JENKINS_HOME, largest first.
usage_breakdown() {
  # du fails on a pattern that matches nothing (no jobs yet); what it did measure still counts.
  (cd "$home" && du -sk workspace/*/* jobs/*/jobs/*/builds jobs/*/builds plugins war 2>/dev/null || true) \
    | sort -rn | awk -v n="${1:-8}" 'NR <= n' | while read -r kb path; do
      printf '  %8s  %s\n' "$(kb_to_human "$kb")" "$path"
    done
}

# Loud, not silent: every build checks the total against JENKINS_LOCAL_WARN_GB.
warn_if_big() {
  local kb
  kb=$(du -sk "$home" 2>/dev/null | cut -f1)
  if [ "${kb:-0}" -gt $((warn_gb * 1024 * 1024)) ]; then
    {
      echo "jenkins-local: WARNING: $home is $(kb_to_human "$kb") (over JENKINS_LOCAL_WARN_GB=$warn_gb). Biggest:"
      usage_breakdown 5
      echo "  Free space: jenkins-local prune; old jobs: delete them in the UI."
    } >&2
  fi
}

busy_executors() {
  curl -sf "http://127.0.0.1:$port/computer/api/json?tree=busyExecutors" \
    | grep -o '"busyExecutors":[0-9]*' | cut -d: -f2
}

status() {
  if running; then echo "Jenkins: running at http://127.0.0.1:$port"; else echo "Jenkins: stopped"; fi
  echo "Data: $home, $(kb_to_human "$(du -sk "$home" 2>/dev/null | cut -f1)") (warning above ${warn_gb}G)"
  usage_breakdown
  echo "Global secrets: $(ls "$secrets" 2>/dev/null | wc -l)"
  echo "Jobs:"
  local cfg repo
  for cfg in "$home"/jobs/*/config.xml; do
    [ -f "$cfg" ] || continue
    repo=$(grep -o '<description>Local builds of [^<]*(managed' "$cfg" | sed 's/<description>Local builds of //; s/ (managed$//' || true)
    if [ -z "$repo" ]; then
      echo "  $(basename "$(dirname "$cfg")")  (not made by jenkins-local)"
    elif [ -d "$repo" ]; then
      echo "  $(basename "$(dirname "$cfg")")  $repo"
    else
      echo "  $(basename "$(dirname "$cfg")")  $repo  (repo gone: delete the job in the UI)"
    fi
  done
}

# Workspaces are only needed while a build runs; anything left (a --keep-workspace build,
# an interrupted one, a job that was moved or deleted) goes. Build logs are kept.
prune() {
  if running; then
    local busy
    busy=$(busy_executors || true)
    [ "${busy:-0}" = 0 ] || die "$busy build(s) running; prune when they finish"
  fi
  local before after
  before=$(du -sk "$home" | cut -f1)
  rm -rf "${home:?}/workspace" "$home"/.job-*.xml
  after=$(du -sk "$home" | cut -f1)
  echo "Freed $(kb_to_human $((before - after))); $home is now $(kb_to_human "$after")."
}

# Build ../selftest/Jenkinsfile as a throwaway repo, then check from outside what the build
# can't see itself. Leaves nothing behind but the pulled alpine image.
selftest() {
  # Not `name`: that is the container's, and bash locals are visible to called functions.
  local sample=jenkins-local-selftest
  local src=$home/selftest/$sample log=$home/selftest/build.log
  local build_dir=$home/jobs/$sample/jobs/build/builds
  local failures=0 rc=0 n

  check() { if eval "$2"; then echo "  ok    $1"; else echo "  FAIL  $1"; failures=$((failures + 1)); fi; }
  # Jenkins prints a step's error at the end of the log, not in its stage; but every stage
  # after a failure says "skipped due to earlier failure(s)". So the failed stage is the last
  # one that ran before the first skipped one, and a stage passed if it ran, wasn't skipped,
  # and isn't that one.
  stage_ok() {
    local failed_stage
    failed_stage=$(awk '
      /^\[Pipeline\] \{ \(/ && !/Declarative/ { st = substr($0, 15); sub(/\)$/, "", st) }
      /skipped due to earlier failure/ { print done; exit }
      /^\[Pipeline\] \/\/ stage/ { done = st }' "$log" 2>/dev/null || true)
    [ "$1" != "$failed_stage" ] || return 1
    grep -qF "[Pipeline] { ($1)" "$log" && ! grep -qF "Stage \"$1\" skipped" "$log"
  }

  start
  rm -rf "$src" && mkdir -p "$src"
  cp "$(dirname "$conf")/selftest/Jenkinsfile" "$src/"
  echo "copied into the workspace" > "$src/marker.txt"
  echo "must not be copied" > "$src/ignored.txt"
  printf 'ignored.txt\n.env\n' > "$src/.gitignore"
  echo "SELFTEST_TOKEN=from-dotenv" > "$src/.env"
  git -C "$src" init -q

  echo "Building the sample project (first run pulls alpine:3.20)..." >&2
  (cd "$src" && build) > "$log" 2>&1 || rc=$?
  n=$(ls "$build_dir" 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tail -1 || true)

  echo "jenkins-local selftest:"
  check "build passed" '[ "$rc" = 0 ]'
  for stage in "Docker agent" "Workspace" "Secret from .env" "Artifact and test report"; do
    check "stage: $stage" 'stage_ok "$stage"'
  done
  check "artifact archived" '[ "$(cat "$build_dir/$n/archive/artifact.txt" 2>/dev/null)" = selftest-ok ]'
  check "test report recorded" '[ -f "$build_dir/$n/junitResult.xml" ]'
  check "workspace deleted after the build" '[ ! -e "$home/workspace/$sample/build" ]'

  if [ "$failures" = 0 ]; then
    cli delete-job "$sample" >/dev/null 2>&1 || true
    rm -rf "$home/selftest" "$home/workspace/$sample"
    echo "All good."
  else
    echo "$failures check(s) failed. Build log: $log (job kept: http://127.0.0.1:$port/job/$sample/)"
    return 1
  fi
}

build() {
  local env_file="" use_env=1 keep_ws=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -e|--env-file) [ -n "${2:-}" ] || die "$1 needs a file"; env_file=$2; shift 2 ;;
      --no-env) use_env=0; shift ;;
      --keep-workspace) keep_ws=1; shift ;;
      *) die "unknown option '$1' (see: jenkins-local help)" ;;
    esac
  done

  local repo folder job ws script
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git repo"
  [ -f "$repo/Jenkinsfile" ] || die "no Jenkinsfile in $repo"

  if [ "$use_env" = 0 ]; then
    env_file=""
  elif [ -n "$env_file" ]; then
    [ -f "$env_file" ] || die "no such env file: $env_file"
    env_file=$(realpath "$env_file")
  elif [ -f "$repo/.env" ]; then
    env_file=$repo/.env
  fi
  start

  # One folder per repo (holding its env-file secrets), with the job inside.
  folder=$(basename "$repo" | tr -c 'A-Za-z0-9._\n-' '-')
  job=$folder/build
  # Before folders, the job itself was named after the repo; that one is replaced.
  if cli get-job "$folder" 2>/dev/null | grep -q '<flow-definition'; then
    cli delete-job "$folder"
  fi
  if cli get-job "$folder" >/dev/null 2>&1; then
    folder_xml "$env_file" "Local builds of $repo (managed by jenkins-local)" | cli update-job "$folder"
  else
    folder_xml "$env_file" "Local builds of $repo (managed by jenkins-local)" | cli create-job "$folder"
  fi
  if [ -n "$env_file" ]; then
    echo "Secrets from $env_file: $(read_env_file "$env_file" | cut -f1 | paste -sd' ')" >&2
  fi

  # The Jenkinsfile goes into the job inline, so the build needs no checkout.
  script=$(xml_escape < "$repo/Jenkinsfile")
  REPO=$repo SCRIPT=$script perl -pe 's/__REPO__/$ENV{REPO}/g; s/__SCRIPT__/$ENV{SCRIPT}/g' \
    "$conf/job.xml" > "$home/.job-$folder.xml"
  if cli get-job "$job" >/dev/null 2>&1; then
    cli update-job "$job" < "$home/.job-$folder.xml"
  else
    cli create-job "$job" < "$home/.job-$folder.xml"
  fi
  rm -f "$home/.job-$folder.xml"

  # A fresh workspace every build, as a CI checkout would be.
  ws=$home/workspace/$job
  rm -rf "$ws" && mkdir -p "$ws"
  (cd "$repo" && git ls-files -z --cached --others --exclude-standard \
    | rsync -a --from0 --files-from=- --ignore-missing-args ./ "$ws/")
  # A checkout is a git repo, and tools like pre-commit need one: commit the copy, on a
  # branch of the same name.
  local branch
  branch=$(git -C "$repo" branch --show-current); branch=${branch:-local}
  git -C "$ws" init -q -b "$branch"
  git -C "$ws" add -A
  git -C "$ws" -c user.name=jenkins-local -c user.email=jenkins-local@localhost \
    commit -q --no-verify -m "Working tree of $repo"

  warn_if_big
  echo "Building $job (working tree of $repo): http://127.0.0.1:$port/job/$folder/job/build/" >&2
  # -f waits for the result and sets the exit code; -v streams the console log.
  local rc=0
  cli build "$job" -f -v || rc=$?

  # The workspace (a venv, caches: hundreds of MB) is rebuilt next time anyway. On Ctrl-C the
  # script stops before this while the build may still run, so it is left for `prune`.
  if [ "$keep_ws" = 1 ]; then
    echo "Workspace kept: $ws" >&2
  else
    rm -rf "$ws" "$ws@tmp" "$ws@script" "$ws@libs"
  fi
  return "$rc"
}

case "${1:-build}" in
  build) shift || true; build "$@" ;;
  -e|--env-file|--no-env|--keep-workspace) build "$@" ;;
  start) start ;;
  status) status ;;
  prune) prune ;;
  selftest) selftest ;;
  restart) docker rm -f "$name" >/dev/null 2>&1 || true; start ;;
  stop) docker rm -f "$name" >/dev/null 2>&1 || true; echo "stopped (data kept in $home)" ;;
  logs) docker logs -f "$name" ;;
  secret) shift; secret "$@" ;;
  -h|--help|help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (see: jenkins-local help)" ;;
esac
