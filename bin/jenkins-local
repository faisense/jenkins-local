#!/usr/bin/env bash
# A local Jenkins for trying any project's Jenkinsfile. Not a CI server: it builds on demand.
#
#   jenkins-local            in a git repo with a Jenkinsfile: build the working tree as it is
#                            now, stream the log, exit with the build's result (starts Jenkins
#                            if needed). The repo's .env, if there is one, supplies its secrets:
#                            each KEY=value line, overriding a global secret of the same ID,
#                            for this repo only. Key names set the credential type:
#                              X_USR + X_PSW       usernamePassword X
#                              X_FILE=path         file X (path relative to the env file)
#                              X_SSH_KEY=path      sshUserPrivateKey X (+ X_SSH_USER, default
#                                                  git, and X_SSH_PASSPHRASE)
#                              anything else       secret text
#                            Agent labels the Jenkinsfile asks for (agent { label 'gpu' },
#                            node('linux')) are added to this machine, the only agent.
#   jenkins-local -e FILE    use another env file instead (--env-file)
#   jenkins-local --no-env   no repo secrets; only the global ones apply
#   jenkins-local --keep-workspace
#                            keep the build's workspace afterwards (deleted by default)
#   jenkins-local status     running or not, disk use, global secrets, jobs (and stale ones)
#   jenkins-local prune      delete leftover workspaces (refuses while a build runs)
#   jenkins-local selftest   build a small sample project and check each feature: docker
#                            agent, workspace, .env secret, artifacts, test report, cleanup
#   jenkins-local start      start Jenkins (http://127.0.0.1:8090)
#   jenkins-local restart    rebuild the image and recreate the container; needed after editing
#                            Dockerfile or plugins.txt
#   jenkins-local stop       stop it; jobs and build history are kept
#   jenkins-local logs       follow Jenkins' own log
#
#   jenkins-local secret set ID     store a "Secret text" credential; asks for the value (hidden),
#                                   or reads it from stdin: ... | jenkins-local secret set ID
#   jenkins-local secret list       list the IDs (never the values)
#   jenkins-local secret rm ID      delete one
# A Jenkinsfile uses them with withCredentials([string(credentialsId: 'ID', variable: ...)]).
# Changes apply to a running Jenkins at once; no restart.
#
# No commit needed: each build is a Multibranch build of a snapshot of the working tree (the
# files git would commit: tracked + untracked, minus .gitignore'd ones like .venv and .env),
# so `checkout scm`, BRANCH_NAME and GIT_COMMIT work as on a CI server.
#
# Files:
#   <this repo>/config/               Dockerfile, plugins.txt (the Jenkins image)
#   ~/.config/jenkins-local/secrets/  one file per secret (managed by `secret`), mode 600;
#                                     outside the repo, so never committed
#   ~/.local/share/jenkins-local/     JENKINS_HOME: jobs, builds, workspaces
#
# Settings (environment):
#   JENKINS_LOCAL_PORT    default 8090
#   JENKINS_LOCAL_WARN_GB every build warns when the data passes this size; default 5
#
# Disk use stays bounded: workspaces are deleted after each build, jobs keep their last 20
# builds (unless the Jenkinsfile sets its own buildDiscarder), the container log is capped
# at 30 MB, and anything over JENKINS_LOCAL_WARN_GB is reported on every build.
set -euo pipefail

# The image and job template live in the repo, next to bin/ (found through the
# ~/.local/bin symlink); per-machine state lives outside it.
conf=$(cd "$(dirname "$(realpath "$0")")/../config" && pwd)
home=${XDG_DATA_HOME:-$HOME/.local/share}/jenkins-local
port=${JENKINS_LOCAL_PORT:-8090}
warn_gb=${JENKINS_LOCAL_WARN_GB:-5}
secrets=${XDG_CONFIG_HOME:-$HOME/.config}/jenkins-local/secrets
name=jenkins-local
image=jenkins-local

die() { echo "jenkins-local: $*" >&2; exit 1; }

running() { [ "$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null)" = true ]; }

cli() {
  docker exec -i "$name" java -jar "$home/jenkins-cli.jar" -s http://localhost:8080/ -http "$@"
}

# casc.yaml lists the credential IDs only. JCasC resolves each ${ID} from the file of that
# name in /run/secrets (the secrets directory, mounted read-only), so values stay in one place.
write_casc() {
  {
    echo "# Generated by jenkins-local at every start; edit the script, not this file."
    echo "jenkins:"
    echo "  systemMessage: \"Local Jenkins for trying Jenkinsfiles (jenkins-local).\""
    echo "  numExecutors: 2"
    echo "  authorizationStrategy: unsecured   # bound to 127.0.0.1 only"
    echo "unclassified:"
    echo "  location:"
    echo "    url: \"http://127.0.0.1:$port/\"   # the CLI refuses to connect without one"
    echo "credentials:"
    echo "  system:"
    echo "    domainCredentials:"
    echo "      - credentials:"
    local f found=0
    for f in "$secrets"/*; do
      [ -f "$f" ] || continue
      found=1
      echo "          - string: {scope: GLOBAL, id: \"${f##*/}\", secret: \"\${${f##*/}}\"}"
    done
    [ "$found" = 1 ] || echo "          []"
  } > "$home/casc.yaml"
}

# Apply casc.yaml to a running Jenkins (credentials included) without restarting it.
apply_casc() {
  write_casc
  if running; then
    cli reload-jcasc-configuration && echo "applied to the running Jenkins" >&2
  fi
}

secret() {
  local id
  case "${1:-}" in
    set)
      id=${2:-}; valid_id "$id"
      local value
      if [ -t 0 ]; then
        read -rsp "Value for $id (hidden): " value; echo >&2
      else
        IFS= read -r value || [ -n "$value" ]
      fi
      [ -n "$value" ] || die "empty value; nothing stored"
      mkdir -p "$secrets" && chmod 700 "$secrets"
      # No trailing newline: the file's content is the secret, byte for byte.
      (umask 077 && printf '%s' "$value" > "$secrets/$id")
      echo "stored $id" >&2
      apply_casc
      ;;
    list)
      [ -d "$secrets" ] && ls -1 "$secrets"
      ;;
    rm)
      id=${2:-}; valid_id "$id"
      [ -f "$secrets/$id" ] || die "no secret '$id' (see: jenkins-local secret list)"
      rm -f "$secrets/$id"
      echo "removed $id" >&2
      apply_casc
      ;;
    *) die "usage: jenkins-local secret set|list|rm [ID]" ;;
  esac
}

# Letters, digits and _ only: the ID is also the ${...} name JCasC resolves.
valid_id() {
  [[ "${1:-}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "secret ID must match [A-Za-z_][A-Za-z0-9_]* (got '${1:-}')"
}

start() {
  running && return 0
  [ -f "$conf/Dockerfile" ] || die "missing $conf/Dockerfile"
  mkdir -p "$home" "$secrets" && chmod 700 "$secrets"
  write_casc

  echo "Building the image..." >&2
  docker build -q -t "$image" "$conf" >/dev/null
  docker rm -f "$name" >/dev/null 2>&1 || true

  # JENKINS_HOME at the same absolute path inside and out: a docker agent asks the host's
  # daemon to mount the workspace, and this script fills workspaces from the host.
  # Runs as you, so workspace files are yours and the docker socket's group applies.
  # The container log is capped (Docker keeps it forever otherwise).
  docker run -d --name "$name" --restart unless-stopped \
    --log-opt max-size=10m --log-opt max-file=3 \
    -u "$(id -u):$(id -g)" --group-add "$(stat -c %g /var/run/docker.sock)" \
    -p "127.0.0.1:$port:8080" \
    -e JENKINS_HOME="$home" -e HOME="$home" \
    -e COPY_REFERENCE_FILE_LOG="$home/copy_reference_file.log" \
    -v "$home:$home" \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -e CASC_JENKINS_CONFIG="$home/casc.yaml" \
    -v "$secrets:/run/secrets:ro" \
    "$image" >/dev/null

  echo "Waiting for Jenkins at http://127.0.0.1:$port ..." >&2
  local i
  for i in $(seq 120); do
    curl -sf -o /dev/null "http://127.0.0.1:$port/login" && break
    running || { docker logs --tail 20 "$name" >&2; die "Jenkins exited during startup"; }
    sleep 1
  done
  curl -sf -o /dev/null "http://127.0.0.1:$port/login" || die "Jenkins did not come up; see: jenkins-local logs"
  curl -sf -o "$home/jenkins-cli.jar" "http://127.0.0.1:$port/jnlpJars/jenkins-cli.jar"
  echo "Jenkins is up: http://127.0.0.1:$port" >&2
}

xml_escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

# KEY=value lines of an env file as "KEY<TAB>value": `export` prefix, quotes and inline
# " # comments" handled as docker compose does; blank values skipped.
read_env_file() {
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    [[ $line =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    key=${BASH_REMATCH[2]} val=${BASH_REMATCH[3]}
    if [[ $val =~ ^\"(.*)\"[[:space:]]*(#.*)?$ || $val =~ ^\'(.*)\'[[:space:]]*(#.*)?$ ]]; then
      val=${BASH_REMATCH[1]}
    else
      val=$(sed -e 's/[[:space:]]\{1,\}#.*$//' -e 's/[[:space:]]*$//' <<< "$val")
    fi
    if [ -n "$val" ]; then printf '%s\t%s\n' "$key" "$val"; fi
  done < "$1"
}

# The credentials an env file defines, one "type<TAB>ID" line each. The type comes from the
# key names, following Jenkins' own naming where it has one:
#   X_USR + X_PSW                     usernamePassword X (the variables credentials('X') sets)
#   X_FILE=path                       file X, with that file's content
#   X_SSH_KEY=path [+ X_SSH_USER, X_SSH_PASSPHRASE]
#                                     sshUserPrivateKey X (user defaults to git)
#   anything else                     string (secret text), ID = the key
# Paths are relative to the env file. Keys used by a pair or a key are not also strings.
env_credentials() {
  local entries key base
  entries=$(read_env_file "$1")
  has() { awk -F'\t' -v k="$1" '$1 == k { f = 1 } END { exit !f }' <<< "$entries"; }
  while IFS=$'\t' read -r key _; do
    [ -n "$key" ] || continue
    case "$key" in
      *_USR) base=${key%_USR}; if has "${base}_PSW"; then printf 'usernamePassword\t%s\n' "$base"; continue; fi ;;
      *_PSW) base=${key%_PSW}; has "${base}_USR" && continue ;;
      *_SSH_KEY) printf 'sshUserPrivateKey\t%s\n' "${key%_SSH_KEY}"; continue ;;
      *_SSH_USER) has "${key%_SSH_USER}_SSH_KEY" && continue ;;
      *_SSH_PASSPHRASE) has "${key%_SSH_PASSPHRASE}_SSH_KEY" && continue ;;
      *_FILE) printf 'file\t%s\n' "${key%_FILE}"; continue ;;
    esac
    printf 'string\t%s\n' "$key"
  done <<< "$entries"
}

# Value of KEY in an env file (empty if absent).
env_value() { read_env_file "$1" | awk -F'\t' -v k="$2" '$1 == k { print substr($0, length(k) + 2); exit }'; }

# An env file path value, resolved against the env file's directory; must exist.
env_path() {
  local p
  p=$(env_value "$1" "$2")
  case "$p" in /*) ;; *) p=$(dirname "$1")/$p ;; esac
  [ -f "$p" ] || die "$2 in $1 points to a missing file: $p"
  printf '%s' "$p"
}

# The <credentials> entries for an env file, per env_credentials. Values in plain text.
credentials_xml() {
  local env_file=$1 type id desc path
  desc=$(xml_escape <<< "from $env_file")
  while IFS=$'\t' read -r type id; do
    case "$type" in
      string)
        echo "          <org.jenkinsci.plugins.plaincredentials.impl.StringCredentialsImpl>"
        echo "            <scope>GLOBAL</scope><id>$id</id><description>$desc</description>"
        echo "            <secret>$(env_value "$env_file" "$id" | xml_escape)</secret>"
        echo "          </org.jenkinsci.plugins.plaincredentials.impl.StringCredentialsImpl>"
        ;;
      usernamePassword)
        echo "          <com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl>"
        echo "            <scope>GLOBAL</scope><id>$id</id><description>$desc</description>"
        echo "            <username>$(env_value "$env_file" "${id}_USR" | xml_escape)</username>"
        echo "            <password>$(env_value "$env_file" "${id}_PSW" | xml_escape)</password>"
        echo "            <usernameSecret>false</usernameSecret>"
        echo "          </com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl>"
        ;;
      file)
        path=$(env_path "$env_file" "${id}_FILE")
        echo "          <org.jenkinsci.plugins.plaincredentials.impl.FileCredentialsImpl>"
        echo "            <scope>GLOBAL</scope><id>$id</id><description>$desc</description>"
        echo "            <fileName>$(basename "$path" | xml_escape)</fileName>"
        echo "            <secretBytes>$(base64 < "$path" | tr -d '\n')</secretBytes>"
        echo "          </org.jenkinsci.plugins.plaincredentials.impl.FileCredentialsImpl>"
        ;;
      sshUserPrivateKey)
        path=$(env_path "$env_file" "${id}_SSH_KEY")
        local user
        user=$(env_value "$env_file" "${id}_SSH_USER"); user=${user:-git}
        echo "          <com.cloudbees.jenkins.plugins.sshcredentials.impl.BasicSSHUserPrivateKey>"
        echo "            <scope>GLOBAL</scope><id>$id</id><description>$desc</description>"
        echo "            <username>$(xml_escape <<< "$user")</username><usernameSecret>false</usernameSecret>"
        echo "            <privateKeySource class=\"com.cloudbees.jenkins.plugins.sshcredentials.impl.BasicSSHUserPrivateKey\$DirectEntryPrivateKeySource\">"
        echo "              <privateKey>$(xml_escape < "$path")</privateKey>"
        echo "            </privateKeySource>"
        echo "            <passphrase>$(env_value "$env_file" "${id}_SSH_PASSPHRASE" | xml_escape)</passphrase>"
        echo "          </com.cloudbees.jenkins.plugins.sshcredentials.impl.BasicSSHUserPrivateKey>"
        ;;
    esac
  done < <(env_credentials "$env_file")
}

# Config of the repo's Multibranch project: branches come from the repo's snapshot remote
# (see snapshot), so builds get a real checkout, `checkout scm` and BRANCH_NAME as on a CI
# server. Branch jobs are only built on request (NoTriggerBranchProperty), never on indexing.
# The project is a folder: its credentials override global ones with the same ID for the
# branches inside, so each repo can have its own values. Without an env file it has none,
# and the global `secret` store applies. Secrets are in plain text here; Jenkins encrypts
# them on save. Printed to stdout only, for piping straight into the CLI.
project_xml() {
  local env_file=${1:-} desc=${2:-} remote=${3:-} key val
  echo "<org.jenkinsci.plugins.workflow.multibranch.WorkflowMultiBranchProject>"
  echo "  <description>$(xml_escape <<< "$desc")</description>"
  echo "  <orphanedItemStrategy class=\"com.cloudbees.hudson.plugins.folder.computed.DefaultOrphanedItemStrategy\">"
  echo "    <pruneDeadBranches>true</pruneDeadBranches><daysToKeep>-1</daysToKeep><numToKeep>-1</numToKeep>"
  echo "    <abortBuilds>false</abortBuilds>"
  echo "  </orphanedItemStrategy>"
  echo "  <sources class=\"jenkins.branch.MultiBranchProject\$BranchSourceList\"><data>"
  echo "    <jenkins.branch.BranchSource>"
  echo "      <source class=\"jenkins.plugins.git.GitSCMSource\">"
  echo "        <id>jenkins-local</id>"
  echo "        <remote>$(xml_escape <<< "file://$remote")</remote>"
  echo "        <traits><jenkins.plugins.git.traits.BranchDiscoveryTrait/></traits>"
  echo "      </source>"
  echo "      <strategy class=\"jenkins.branch.DefaultBranchPropertyStrategy\">"
  echo "        <properties class=\"java.util.Arrays\$ArrayList\"><a class=\"jenkins.branch.BranchProperty-array\">"
  echo "          <jenkins.branch.NoTriggerBranchProperty/>"
  # Keep the last 20 builds per branch; a Jenkinsfile's own buildDiscarder wins.
  echo "          <jenkins.branch.BuildRetentionBranchProperty><buildDiscarder class=\"hudson.tasks.LogRotator\">"
  echo "            <daysToKeep>-1</daysToKeep><numToKeep>20</numToKeep>"
  echo "            <artifactDaysToKeep>-1</artifactDaysToKeep><artifactNumToKeep>-1</artifactNumToKeep>"
  echo "          </buildDiscarder></jenkins.branch.BuildRetentionBranchProperty>"
  echo "        </a></properties>"
  echo "      </strategy>"
  echo "    </jenkins.branch.BranchSource>"
  echo "  </data></sources>"
  echo "  <factory class=\"org.jenkinsci.plugins.workflow.multibranch.WorkflowBranchProjectFactory\">"
  echo "    <scriptPath>Jenkinsfile</scriptPath>"
  echo "  </factory>"
  echo "  <properties>"
  if [ -n "$env_file" ]; then
    echo "    <com.cloudbees.hudson.plugins.folder.properties.FolderCredentialsProvider_-FolderCredentialsProperty>"
    echo "      <domainCredentialsMap class=\"hudson.util.CopyOnWriteMap\$Hash\"><entry>"
    echo "        <com.cloudbees.plugins.credentials.domains.Domain><specifications/></com.cloudbees.plugins.credentials.domains.Domain>"
    echo "        <java.util.concurrent.CopyOnWriteArrayList>"
    credentials_xml "$env_file"
    echo "        </java.util.concurrent.CopyOnWriteArrayList>"
    echo "      </entry></domainCredentialsMap>"
    echo "    </com.cloudbees.hudson.plugins.folder.properties.FolderCredentialsProvider_-FolderCredentialsProperty>"
  fi
  echo "  </properties>"
  echo "</org.jenkinsci.plugins.workflow.multibranch.WorkflowMultiBranchProject>"
}

# Commit the working tree as it is now (what git would commit: tracked + untracked, minus
# .gitignore'd files) and force-push it to the repo's snapshot remote, on a branch of the
# same name. A throwaway index is used, so the repo's index, branch and files are untouched;
# only a commit object is added to its .git. Prints the snapshot commit.
snapshot() {
  local repo=$1 remote=$2 branch=$3 index tree commit parent=()
  [ -d "$remote" ] || git init -q --bare "$remote"
  index=$(mktemp "$home/.index.XXXXXX")
  # Start from HEAD so files tracked despite .gitignore stay in, as in a commit.
  if git -C "$repo" rev-parse -q --verify HEAD >/dev/null; then
    GIT_INDEX_FILE=$index git -C "$repo" read-tree HEAD
    parent=(-p HEAD)
  else
    rm -f "$index"
  fi
  GIT_INDEX_FILE=$index git -C "$repo" add -A
  tree=$(GIT_INDEX_FILE=$index git -C "$repo" write-tree)
  rm -f "$index"
  commit=$(GIT_AUTHOR_NAME=jenkins-local GIT_AUTHOR_EMAIL=jenkins-local@localhost \
    GIT_COMMITTER_NAME=jenkins-local GIT_COMMITTER_EMAIL=jenkins-local@localhost \
    git -C "$repo" commit-tree "$tree" "${parent[@]}" -m "Working tree of $repo")
  # --no-verify: the repo's own pre-push hooks are for real remotes, not this one.
  git -C "$repo" push -q --no-verify --force "$remote" "$commit:refs/heads/$branch"
  echo "$commit"
}

# Agent labels a Jenkinsfile asks for, one per line: declarative `label 'x'` (also inside
# docker { }), scripted node('x') / node(label: 'x'); expressions such as 'linux && gpu' give
# each label. `sh label: '...'` is a step's display name, not an agent label, so a `label`
# followed by a colon is skipped.
jenkinsfile_labels() {
  perl -ne '
    while (/(?:^|[\s{;])label\s+["\x27]([^"\x27]+)["\x27]/g) { print "$1\n" }
    while (/\bnode\s*\(\s*(?:label\s*:\s*)?["\x27]([^"\x27]+)["\x27]/g) { print "$1\n" }
  ' "$1" | tr -s '&|!()[:space:]' '\n' | grep -E '^[A-Za-z0-9_.-]+$' | sort -u || true
}

# Here the only agent is this machine, so it gets every label the Jenkinsfile asks for;
# otherwise `agent { label 'gpu' }` would wait forever for a node that never comes. Labels
# are only added (other repos may need theirs) and printed when new.
ensure_labels() {
  local labels
  labels=$(jenkinsfile_labels "$1" | paste -sd' ')
  [ -n "$labels" ] || return 0
  cli groovy = <<EOF | sed 's/^/Agent labels added to this machine: /' >&2
def j = jenkins.model.Jenkins.get()
def have = (j.labelString ?: '').split(/\s+/).findAll { it } as LinkedHashSet
def want = '$labels'.split(' ') as List
def added = want.findAll { !have.contains(it) }
if (added) { have.addAll(added); j.setLabelString(have.join(' ')); j.save(); println(added.join(' ')) }
// Labels cache which nodes match them (expressions too), and the cache can go stale (e.g.
// one asked for before its labels existed); then the stage waits forever on a node that
// has the labels. Recomputing every time is cheap.
j.labels.each { it.reset() }
EOF
}

# The name a Multibranch project gives a branch job: the branch, URL-encoded (a/b -> a%2Fb).
branch_job_name() { printf '%s' "$1" | perl -pe 's/([^A-Za-z0-9._~-])/sprintf("%%%02X", ord $1)/ge'; }

# Run branch indexing so a new branch gets its job, and wait for it to finish.
index_branch() {
  local project=$1 job=$2 since
  since=$(indexing_stamp "$project")
  echo "jenkins.model.Jenkins.get().getItemByFullName('$project').scheduleBuild2(0)" | cli groovy = >/dev/null
  wait_indexing "$project" "$since"
  cli get-job "$job" >/dev/null 2>&1 \
    || die "branch indexing did not create $job; see http://127.0.0.1:$port/job/$project/indexing/"
}

# Start time (ms) of the project's latest branch indexing; 0 if none.
indexing_stamp() {
  echo "println(jenkins.model.Jenkins.get().getItemByFullName('$1')?.computation?.timestamp?.timeInMillis ?: 0)" \
    | cli groovy =
}

# Wait for an indexing newer than $2 (an indexing_stamp) to finish. Creating or updating a
# Multibranch project starts one by itself; a build started while it runs can have its
# record replaced when the branch job is updated, and then any stage that asks for a node
# ("Stopping part of ...") waits until it times out. Gives up quietly after 120 s.
wait_indexing() {
  cli groovy = <<EOF >/dev/null
def p = jenkins.model.Jenkins.get().getItemByFullName('$1')
def t0 = System.currentTimeMillis()
def newer = { (p?.computation?.timestamp?.timeInMillis ?: 0) > $2L }
while (System.currentTimeMillis() - t0 < 120000) {
  if (newer() && !p.computation.isBuilding()) break
  // Never started (nothing to index): don't wait the full time.
  if (!newer() && System.currentTimeMillis() - t0 > 15000) break
  Thread.sleep(250)
}
EOF
}

kb_to_human() { awk -v k="$1" 'BEGIN { split("K M G T", u); i = 1; while (k >= 1024 && i < 4) { k /= 1024; i++ } printf "%.1f%s", k, u[i] }'; }

# The biggest things in JENKINS_HOME, largest first.
usage_breakdown() {
  # du fails on a pattern that matches nothing (no jobs yet); what it did measure still counts.
  (cd "$home" && du -sk workspace/* jobs/*/branches/*/builds sources/* plugins war 2>/dev/null || true) \
    | sort -rn | awk -v n="${1:-8}" 'NR <= n' | while read -r kb path; do
      printf '  %8s  %s\n' "$(kb_to_human "$kb")" "$path"
    done
}

# Loud, not silent: every build checks the total against JENKINS_LOCAL_WARN_GB.
warn_if_big() {
  local kb
  kb=$(du -sk "$home" 2>/dev/null | cut -f1)
  if [ "${kb:-0}" -gt $((warn_gb * 1024 * 1024)) ]; then
    {
      echo "jenkins-local: WARNING: $home is $(kb_to_human "$kb") (over JENKINS_LOCAL_WARN_GB=$warn_gb). Biggest:"
      usage_breakdown 5
      echo "  Free space: jenkins-local prune; old jobs: delete them in the UI."
    } >&2
  fi
}

busy_executors() {
  curl -sf "http://127.0.0.1:$port/computer/api/json?tree=busyExecutors" \
    | grep -o '"busyExecutors":[0-9]*' | cut -d: -f2
}

status() {
  if running; then echo "Jenkins: running at http://127.0.0.1:$port"; else echo "Jenkins: stopped"; fi
  echo "Data: $home, $(kb_to_human "$(du -sk "$home" 2>/dev/null | cut -f1)") (warning above ${warn_gb}G)"
  usage_breakdown
  echo "Global secrets: $(ls "$secrets" 2>/dev/null | wc -l)"
  if running; then
    echo "Agent labels: $(echo 'println(jenkins.model.Jenkins.get().labelString ?: "")' | cli groovy = 2>/dev/null || true)"
  fi
  echo "Jobs:"
  local cfg repo
  for cfg in "$home"/jobs/*/config.xml; do
    [ -f "$cfg" ] || continue
    repo=$(grep -o '<description>Local builds of [^<]*(managed' "$cfg" | sed 's/<description>Local builds of //; s/ (managed$//' || true)
    if [ -z "$repo" ]; then
      echo "  $(basename "$(dirname "$cfg")")  (not made by jenkins-local)"
    elif [ -d "$repo" ]; then
      echo "  $(basename "$(dirname "$cfg")")  $repo"
    else
      echo "  $(basename "$(dirname "$cfg")")  $repo  (repo gone: delete the job in the UI)"
    fi
  done
}

# Workspaces are only needed while a build runs; anything left (a --keep-workspace build,
# an interrupted one, a job that was moved or deleted) goes. Build logs are kept.
prune() {
  if running; then
    local busy
    busy=$(busy_executors || true)
    [ "${busy:-0}" = 0 ] || die "$busy build(s) running; prune when they finish"
  fi
  local before after
  before=$(du -sk "$home" | cut -f1)
  rm -rf "${home:?}/workspace" "$home"/.job-*.xml
  after=$(du -sk "$home" | cut -f1)
  echo "Freed $(kb_to_human $((before - after))); $home is now $(kb_to_human "$after")."
}

# Build ../selftest/Jenkinsfile as a throwaway repo, then check from outside what the build
# can't see itself. Leaves nothing behind but the pulled alpine image.
selftest() {
  # Not `name`: that is the container's, and bash locals are visible to called functions.
  local sample=jenkins-local-selftest
  local src=$home/selftest/$sample log=$home/selftest/build.log
  local build_dir failures=0 rc=0 n

  check() { if eval "$2"; then echo "  ok    $1"; else echo "  FAIL  $1"; failures=$((failures + 1)); fi; }
  # Jenkins prints a step's error at the end of the log, not in its stage; but every stage
  # after a failure says "skipped due to earlier failure(s)". So the failed stage is the last
  # one that ran before the first skipped one, and a stage passed if it ran, wasn't skipped,
  # and isn't that one.
  stage_ok() {
    local failed_stage
    failed_stage=$(awk '
      /^\[Pipeline\] \{ \(/ && !/Declarative/ { st = substr($0, 15); sub(/\)$/, "", st) }
      /skipped due to earlier failure/ { print done; exit }
      /^\[Pipeline\] \/\/ stage/ { done = st }' "$log" 2>/dev/null || true)
    [ "$1" != "$failed_stage" ] || return 1
    grep -qF "[Pipeline] { ($1)" "$log" && ! grep -qF "Stage \"$1\" skipped" "$log"
  }

  start
  rm -rf "$src" && mkdir -p "$src"
  cp "$(dirname "$conf")/selftest/Jenkinsfile" "$src/"
  echo "copied into the workspace" > "$src/marker.txt"
  echo "must not be copied" > "$src/ignored.txt"
  printf 'ignored.txt\n.env\nsecrets/\n' > "$src/.gitignore"
  mkdir -p "$src/secrets"
  printf 'certificate-content' > "$src/secrets/cert.txt"
  printf '%s\n' '-----BEGIN OPENSSH PRIVATE KEY-----' 'not-a-real-key' '-----END OPENSSH PRIVATE KEY-----' \
    > "$src/secrets/deploy_key"
  cat > "$src/.env" <<'EOF'
SELFTEST_TOKEN=from-dotenv
SELFTEST_LOGIN_USR=robot
SELFTEST_LOGIN_PSW="pa ss#word"
SELFTEST_CERT_FILE=secrets/cert.txt
SELFTEST_DEPLOY_SSH_KEY=secrets/deploy_key
SELFTEST_DEPLOY_SSH_USER=deployer
EOF
  # On a branch with a slash, to check the branch job's name and BRANCH_NAME.
  git -C "$src" init -q -b selftest/main

  echo "Building the sample project (first run pulls alpine:3.20)..." >&2
  (cd "$src" && build) > "$log" 2>&1 || rc=$?
  build_dir=$(ls -d "$home/jobs/$sample/branches/"*/builds 2>/dev/null | head -1 || true)
  n=$(ls "$build_dir" 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tail -1 || true)

  echo "jenkins-local selftest:"
  check "build passed" '[ "$rc" = 0 ]'
  for stage in "Docker agent" "Workspace" "SCM checkout" "Secret from .env" "Agent label" "Credential types" \
      "Artifact and test report"; do
    check "stage: $stage" 'stage_ok "$stage"'
  done
  check "artifact archived" '[ "$(cat "$build_dir/$n/archive/artifact.txt" 2>/dev/null)" = selftest-ok ]'
  check "test report recorded" '[ -f "$build_dir/$n/junitResult.xml" ]'
  check "built the snapshot just made" \
    '[ -n "$(git -C "$home/sources/$sample.git" rev-parse -q --verify refs/heads/selftest/main)" ] && grep -qx "selftest-commit=$(git -C "$home/sources/$sample.git" rev-parse refs/heads/selftest/main)" "$log"'
  check "workspace deleted after the build" '! ls -d "$home/workspace/${sample}_"* >/dev/null 2>&1'

  if [ "$failures" = 0 ]; then
    cli delete-job "$sample" >/dev/null 2>&1 || true
    rm -rf "$home/selftest" "$home/sources/$sample.git" "$home/.project-$sample.hash"
    echo "All good."
  else
    echo "$failures check(s) failed. Build log: $log (job kept: http://127.0.0.1:$port/job/$sample/)"
    return 1
  fi
}

build() {
  local env_file="" use_env=1 keep_ws=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -e|--env-file) [ -n "${2:-}" ] || die "$1 needs a file"; env_file=$2; shift 2 ;;
      --no-env) use_env=0; shift ;;
      --keep-workspace) keep_ws=1; shift ;;
      *) die "unknown option '$1' (see: jenkins-local help)" ;;
    esac
  done

  local repo project job remote branch commit ws
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git repo"
  [ -f "$repo/Jenkinsfile" ] || die "no Jenkinsfile in $repo"

  if [ "$use_env" = 0 ]; then
    env_file=""
  elif [ -n "$env_file" ]; then
    [ -f "$env_file" ] || die "no such env file: $env_file"
    env_file=$(realpath "$env_file")
  elif [ -f "$repo/.env" ]; then
    env_file=$repo/.env
  fi
  start

  # One Multibranch project per repo (holding its env-file secrets), one job per branch.
  project=$(basename "$repo" | tr -c 'A-Za-z0-9._\n-' '-')
  remote=$home/sources/$project.git
  branch=$(git -C "$repo" branch --show-current); branch=${branch:-detached}
  job=$project/$(branch_job_name "$branch")

  # Fail here on a bad env file (a missing X_FILE...), not halfway through piping the
  # project config into the CLI.
  [ -z "$env_file" ] || credentials_xml "$env_file" > /dev/null

  commit=$(snapshot "$repo" "$remote" "$branch")

  # Older jenkins-local versions made a plain folder (or job) here; that one is replaced.
  if cli get-job "$project" 2>/dev/null | grep -qE '<(com\.cloudbees\.hudson\.plugins\.folder\.Folder|flow-definition)[ >]'; then
    cli delete-job "$project"
  fi
  # Sending the config starts a branch indexing, so it is only sent when it changed (e.g. a
  # new .env value), and then the build waits for that indexing. Only a hash is kept: the
  # config holds the secrets.
  local config hash hash_file=$home/.project-$project.hash since
  config=$(project_xml "$env_file" "Local builds of $repo (managed by jenkins-local)" "$remote")
  hash=$(printf '%s' "$config" | git hash-object --stdin)
  if ! cli get-job "$project" >/dev/null 2>&1; then
    printf '%s\n' "$config" | cli create-job "$project"
    wait_indexing "$project" 0
  elif [ "$(cat "$hash_file" 2>/dev/null)" != "$hash" ]; then
    since=$(indexing_stamp "$project")
    printf '%s\n' "$config" | cli update-job "$project"
    wait_indexing "$project" "$since"
  fi
  echo "$hash" > "$hash_file"
  if [ -n "$env_file" ]; then
    echo "Secrets from $env_file: $(env_credentials "$env_file" \
      | awk -F'\t' '{ printf "%s%s", sep, $2 ($1 == "string" ? "" : " (" $1 ")"); sep = " " }')" >&2
  fi
  cli get-job "$job" >/dev/null 2>&1 || index_branch "$project" "$job"
  ensure_labels "$repo/Jenkinsfile"

  warn_if_big
  echo "Building $project » $branch (working tree at ${commit:0:8}): http://127.0.0.1:$port/job/$project/job/$(branch_job_name "$branch")/" >&2
  # -f waits for the result and sets the exit code; -v streams the console log, which is also
  # kept to find the workspace afterwards (Multibranch names it, e.g. repo_branch).
  local rc=0 log
  log=$(mktemp "$home/.build-log.XXXXXX")
  cli build "$job" -f -v | tee "$log" || rc=$?
  ws=$(sed -n 's/^Running on .* in \(\/.*\)$/\1/p; T; q' "$log")
  rm -f "$log"

  # The workspace (a venv, caches: hundreds of MB) is rebuilt next time anyway. On Ctrl-C the
  # script stops before this while the build may still run, so it is left for `prune`.
  if [ -z "$ws" ]; then
    :
  elif [ "$keep_ws" = 1 ]; then
    echo "Workspace kept: $ws" >&2
  else
    # Also its siblings: @tmp, @script, @libs, and @2... for stages with their own agent.
    case "$ws" in "$home"/workspace/?*) rm -rf "$ws" "$ws"@* ;; esac
  fi
  return "$rc"
}

case "${1:-build}" in
  build) shift || true; build "$@" ;;
  -e|--env-file|--no-env|--keep-workspace) build "$@" ;;
  start) start ;;
  status) status ;;
  prune) prune ;;
  selftest) selftest ;;
  restart) docker rm -f "$name" >/dev/null 2>&1 || true; start ;;
  stop) docker rm -f "$name" >/dev/null 2>&1 || true; echo "stopped (data kept in $home)" ;;
  logs) docker logs -f "$name" ;;
  secret) shift; secret "$@" ;;
  -h|--help|help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (see: jenkins-local help)" ;;
esac
