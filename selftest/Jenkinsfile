// Built by `jenkins-local selftest`. Each stage exercises one thing a real Jenkinsfile relies
// on; the command then checks the results from outside. Keep it small and quick.
pipeline {
    // Docker Pipeline plugin + docker CLI + socket + same-path workspace mount.
    agent { docker { image 'alpine:3.20' } }

    stages {
        stage('Docker agent') {
            steps {
                sh 'echo "alpine $(cat /etc/alpine-release), uid $(id -u)"'
            }
        }

        // The workspace is a checkout of the working-tree snapshot: untracked files in,
        // .gitignore'd ones out.
        stage('Workspace') {
            steps {
                sh 'test -d .git && test -f Jenkinsfile && test -f marker.txt && test ! -e ignored.txt'
            }
        }

        // A Multibranch job: BRANCH_NAME is the repo's branch, and `checkout scm` works.
        // On the built-in node, which has git (alpine doesn't).
        stage('SCM checkout') {
            agent any
            steps {
                checkout scm
                sh '[ "$BRANCH_NAME" = "selftest/main" ] && [ -n "$GIT_COMMIT" ] && test -f marker.txt'
            }
        }

        // SELFTEST_TOKEN comes from the sample's .env (a folder credential).
        stage('Secret from .env') {
            steps {
                withCredentials([string(credentialsId: 'SELFTEST_TOKEN', variable: 'T')]) {
                    sh '[ "$T" = "from-dotenv" ]'
                }
            }
        }

        // From .env naming: _USR/_PSW -> usernamePassword, _FILE -> file,
        // _SSH_KEY (+ _SSH_USER) -> sshUserPrivateKey.
        stage('Credential types') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'SELFTEST_LOGIN', usernameVariable: 'U', passwordVariable: 'P'),
                    file(credentialsId: 'SELFTEST_CERT', variable: 'CERT'),
                    sshUserPrivateKey(credentialsId: 'SELFTEST_DEPLOY', keyFileVariable: 'KEY', usernameVariable: 'KU')
                ]) {
                    sh '''
                        [ "$U" = "robot" ] && [ "$P" = "pa ss#word" ]
                        [ "$(cat "$CERT")" = "certificate-content" ]
                        grep -q "BEGIN OPENSSH PRIVATE KEY" "$KEY" && [ "$KU" = "deployer" ]
                    '''
                }
            }
        }

        stage('Artifact and test report') {
            steps {
                sh '''
                    echo selftest-ok > artifact.txt
                    mkdir -p reports
                    printf '%s\n' '<testsuite name="selftest" tests="1">' \
                        '<testcase classname="selftest" name="works"/></testsuite>' > reports/junit.xml
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'artifact.txt'
            junit 'reports/junit.xml'
        }
    }
}
