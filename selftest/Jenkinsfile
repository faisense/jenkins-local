// Built by `jenkins-local selftest`. Each stage exercises one thing a real Jenkinsfile relies
// on; the command then checks the results from outside. Keep it small and quick.
pipeline {
    // Docker Pipeline plugin + docker CLI + socket + same-path workspace mount.
    agent { docker { image 'alpine:3.20' } }

    stages {
        stage('Docker agent') {
            steps {
                sh 'echo "alpine $(cat /etc/alpine-release), uid $(id -u)"'
            }
        }

        // jenkins-local commits the copied working tree, so the workspace is a git checkout.
        stage('Workspace') {
            steps {
                sh 'test -d .git && test -f Jenkinsfile && test -f marker.txt && test ! -e ignored.txt'
            }
        }

        // SELFTEST_TOKEN comes from the sample's .env (a folder credential).
        stage('Secret from .env') {
            steps {
                withCredentials([string(credentialsId: 'SELFTEST_TOKEN', variable: 'T')]) {
                    sh '[ "$T" = "from-dotenv" ]'
                }
            }
        }

        stage('Artifact and test report') {
            steps {
                sh '''
                    echo selftest-ok > artifact.txt
                    mkdir -p reports
                    printf '%s\n' '<testsuite name="selftest" tests="1">' \
                        '<testcase classname="selftest" name="works"/></testsuite>' > reports/junit.xml
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'artifact.txt'
            junit 'reports/junit.xml'
        }
    }
}
